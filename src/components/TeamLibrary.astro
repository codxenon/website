---
import { Image } from "astro:assets";
import { Icon } from "@astrojs/starlight/components";
import iw2BotWarfare from "../assets/iw2_botwarfare/bot-warfare-gameplay.webp";
import iw4BotWarfare from "../assets/iw4_botwarfare/bot-warfare-logo.png";
import iw5BotWarfare from "../assets/iw5_botwarfare/bot-warfare-logo.png";
import nuketown from "../assets/splash/mp_4nuketown_ingame.webp";

interface Props {
  standalone?: boolean;
}

const { standalone = false } = Astro.props;
const CollectionTitle = standalone ? "h2" : "h3";

const collections = [
  {
    slug: "iw2",
    name: "Call of Duty 2",
    type: "Multiplayer mods",
    image: iw2BotWarfare,
    description:
      "Add bots to multiplayer and adjust their teams and difficulty.",
  },
  {
    slug: "iw3",
    name: "Call of Duty 4",
    type: "Multiplayer maps & mods",
    image: nuketown,
    description:
      "Play custom multiplayer maps, add bots, or load Star Wars Mod: Galactic Warfare.",
  },
  {
    slug: "t4",
    name: "World at War",
    type: "Multiplayer & Zombies",
    image: "/og/t4-fastfiles-zombie-maps.webp",
    description:
      "Find custom multiplayer and Zombies maps, plus Bot Warfare for multiplayer.",
  },
  {
    slug: "iw4",
    name: "Modern Warfare 2",
    type: "Multiplayer maps & mods",
    image: iw4BotWarfare,
    description:
      "Play Bot Warfare on TU6 and find custom maps as they’re released.",
  },
  {
    slug: "iw5",
    name: "Modern Warfare 3",
    type: "Multiplayer mods",
    image: iw5BotWarfare,
    description: "Play System Link and private matches against AI opponents.",
  },
];
---

<section
  id="library"
  class:list={["team-library", "not-content", { standalone }]}
  aria-labelledby={standalone ? "_top" : "library-title"}
>
  <header>
    {!standalone && <h2 id="library-title">Maps &amp; mods</h2>}
    <p>
      Ports curated by the CoD Xenon team. Find the original creators on each
      download page.
    </p>
  </header>
  <div class="collections">
    {collections.map(({ slug, name, type, image, description }) => (
      <a
        class="collection"
        href={`/games/${slug}/`}
        aria-labelledby={`library-${slug}-title`}
      >
        <div class="collection-image">
          {typeof image === "string" ? (
            <img src={image} alt="" width="1200" height="630" loading="lazy" />
          ) : (
            <Image src={image} alt="" width={640} layout="constrained" />
          )}
        </div>
        <div class="collection-copy">
          <p class="collection-type">
            {type}
            <Icon name="right-arrow" class="collection-arrow" />
          </p>
          <CollectionTitle
            class="collection-title"
            id={`library-${slug}-title`}
          >
            {name}
          </CollectionTitle>
          <p>{description}</p>
        </div>
      </a>
    ))}
  </div>
</section>

{!standalone && (
  <div class="resources not-content">
    <div>
      <a href="/help/compatibility/">Game compatibility</a>
      <p>Check supported titles, modes and updates.</p>
    </div>
    <div>
      <a href="/help/">Setup help &amp; beta feedback</a>
      <p>Get help or report an issue with the preview.</p>
    </div>
  </div>
)}

<style>
  .team-library {
    margin-block: clamp(2.5rem, 5vw, 4.5rem);
  }
  .team-library.standalone {
    margin-block: 0;
  }
  header {
    margin-bottom: 1.4rem;
  }
  #library-title {
    color: var(--sl-color-white);
    font-size: clamp(1.9rem, 3.5vw, 2.7rem);
    font-weight: 760;
    letter-spacing: -0.05em;
    line-height: 1.14;
  }
  header p {
    margin-top: 0.45rem;
    color: var(--sl-color-gray-2);
  }
  .collections {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }
  .collection {
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.65rem;
    background: var(--sl-color-bg-sidebar);
    text-decoration: none;
  }
  .collection:hover {
    border-color: var(--sl-color-accent);
  }
  .collection:focus-visible {
    outline: 2px solid var(--sl-color-accent);
    outline-offset: 2px;
  }
  .collection-image {
    aspect-ratio: 2.55;
    overflow: hidden;
  }
  .collection-image img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .collection-copy {
    padding: clamp(1rem, 3vw, 1.5rem);
  }
  .collection-type {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: var(--sl-color-text-accent);
    font-size: 0.875rem;
    font-weight: 650;
  }
  .collection-arrow {
    flex: none;
  }
  .collection-title {
    margin-block: 0.1rem 0.4rem;
    color: var(--sl-color-white);
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 730;
    letter-spacing: -0.045em;
    line-height: 1.2;
  }
  .collection-copy > p:not(.collection-type),
  .resources p {
    color: var(--sl-color-gray-2);
  }
  .resources a {
    color: var(--sl-color-text-accent);
    font-weight: 650;
    text-underline-offset: 0.22em;
  }
  .resources a:hover {
    color: var(--sl-color-white);
  }

  .resources {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
    padding-block: 1.3rem;
    border-block: 1px solid var(--sl-color-gray-5);
  }
  .resources p {
    margin-top: 0.25rem;
  }

  @media (max-width: 40rem) {
    .collections,
    .resources {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
