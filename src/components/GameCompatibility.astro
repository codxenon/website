---
import { games } from "../games.mjs";
import InlineDownload from "./inline-download.astro";
---

<table>
  <thead>
    <tr>
      <th>Game</th>
      <th>Title ID</th>
      <th>Media ID</th>
      <th>Title update</th>
      <th>Modes</th>
    </tr>
  </thead>
  <tbody>
    {games.flatMap((g) =>
      g.updates.map((update) => (
        <tr>
          <td>{g.title}</td>
          <td>
            <code>{g.titleId}</code>
          </td>
          <td>
            <a href={g.disc}>
              <code>{g.mediaId}</code>
            </a>
          </td>
          <td>
            <InlineDownload href={update.url} label={update.label} />
          </td>
          <td>{update.modes}</td>
        </tr>
      )),
    )}
  </tbody>
</table>
