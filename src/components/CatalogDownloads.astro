---
import MapIssueLink from "./MapIssueLink.astro";

const gameNames = {
  iw3: "Call of Duty 4",
  t4: "World at War",
  iw4: "Modern Warfare 2",
} as const;

type Props =
  | {
      game: keyof typeof gameNames;
      modId?: string;
      mapMode?: "multiplayer" | "zombies";
      platform?: never;
    }
  | {
      platform: "xbox360" | "xenia";
      game?: never;
      modId?: never;
      mapMode?: never;
    };

const { game, modId, mapMode, platform } = Astro.props;
const kind = platform ? "client" : modId ? "mod" : "map";
const gameName = game
  ? gameNames[game]
  : platform === "xbox360"
    ? "Xbox 360"
    : "Xenia";

interface Download {
  name: string;
  author?: string;
  sourceUrl?: string;
  mapMode?: string;
  revision: number;
  downloadUrl: string;
  downloadBytes: number;
}

function originalPage(value: unknown): string | undefined {
  if (
    typeof value !== "string" ||
    value.length > 2048 ||
    !value.startsWith("https://")
  )
    return;
  try {
    const url = new URL(value);
    if (!url.username && !url.password && !/[\s\\]/.test(value))
      return url.href;
  } catch {
    // An invalid credit link should leave the map download usable.
  }
}

const origin = "https://packages.codxenon.dev";
const catalogUrl = origin + "/channels/stable.json";
let downloads: Download[] | undefined;
try {
  const response = await fetch(catalogUrl, {
    signal: AbortSignal.timeout(8000),
  });
  if (!response.ok) throw new Error(`Catalog returned HTTP ${response.status}`);
  const pointer = await response.json();
  if (
    pointer.schemaVersion !== 1 ||
    typeof pointer.catalogSha256 !== "string" ||
    !/^[0-9a-f]{64}$/.test(pointer.catalogSha256)
  )
    throw new Error("Invalid stable channel");
  const snapshot = await fetch(
    origin + "/catalogs/" + pointer.catalogSha256 + ".json",
    {
      signal: AbortSignal.timeout(8000),
    },
  );
  if (!snapshot.ok) throw new Error("Catalog snapshot unavailable");
  const bytes = await snapshot.arrayBuffer();
  const hash = new Uint8Array(await crypto.subtle.digest("SHA-256", bytes));
  const hex = Array.from(hash, (byte) =>
    byte.toString(16).padStart(2, "0"),
  ).join("");
  if (hex !== pointer.catalogSha256) throw new Error("Catalog digest mismatch");
  const catalog = JSON.parse(new TextDecoder().decode(bytes));
  if (
    catalog.schemaVersion !== 1 ||
    catalog.channel !== "stable" ||
    !Array.isArray(catalog.packages)
  ) {
    throw new Error("Unexpected catalog format");
  }
  const matches: Download[] = [];
  for (const entry of catalog.packages) {
    if (entry?.kind !== kind) continue;
    if (mapMode && entry.mapMode !== mapMode) continue;
    if (
      platform
        ? entry.target !== platform || entry.id !== "codxe"
        : entry.game !== game || (modId && entry.id !== modId)
    )
      continue;
    const path = platform
      ? `software/client/${platform}/codxe-${platform}-r${entry.revision}.zip`
      : `content/${game}/${kind}s/${entry.id}-r${entry.revision}.zip`;
    if (
      typeof entry.name !== "string" ||
      !entry.name.trim() ||
      !Number.isSafeInteger(entry.revision) ||
      entry.revision < 1 ||
      !Number.isSafeInteger(entry.archive?.bytes) ||
      entry.archive.bytes < 1 ||
      typeof entry.id !== "string" ||
      !/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(entry.id) ||
      entry.archive.path !== path
    )
      throw new Error(`Incomplete ${game} ${kind} download`);
    matches.push({
      ...entry,
      downloadUrl: origin + "/" + entry.archive.path,
      downloadBytes: entry.archive.bytes,
      sourceUrl: originalPage(entry.sourceUrl),
      author: typeof entry.author === "string" ? entry.author : undefined,
    });
  }
  downloads = matches.sort((a, b) => a.name.localeCompare(b.name, "en"));
} catch (error) {
  console.error(`Could not load ${gameName} ${kind} downloads`, error);
}

const showMapMode =
  kind !== "map" || new Set(downloads?.map((item) => item.mapMode)).size > 1;
---

{downloads === undefined ? (
  <p class="catalog-status">
    Downloads are temporarily unavailable. Reload this page to try again.
  </p>
) : downloads.length === 0 ? (
  <p class="catalog-status">
    {mapMode === "multiplayer"
      ? "Multiplayer map downloads will appear here as the team releases them."
      : `No ${kind} downloads are available for ${gameName} yet.`}
  </p>
) : (
  <catalog-download-list>
    {kind === "map" && downloads.length > 1 && (
      <div class="filter" hidden>
        <input
          type="search"
          aria-label="Find a map"
          placeholder="Search by name or author"
        />
        <span role="status">{downloads.length} maps</span>
      </div>
    )}
    <ul
      class:list={[
        "catalog-downloads",
        "not-content",
        { "map-downloads": kind === "map" },
      ]}
      aria-label={`${gameName} ${kind} downloads`}
    >
      {downloads.map((item) => (
        <li
          data-search={
            kind === "map"
              ? `${item.name} ${item.author ?? ""}`.toLowerCase()
              : undefined
          }
        >
          <div class="download-row">
            <div>
              <strong>{item.name}</strong>
              <p class="metadata">
                {[
                  platform && gameName,
                  `r${item.revision}`,
                  showMapMode &&
                    (item.mapMode === "zombies"
                      ? "Zombies"
                      : item.mapMode === "multiplayer"
                        ? "Multiplayer"
                        : undefined),
                  item.author && `By ${item.author}`,
                ]
                  .filter(Boolean)
                  .join(" · ")}
              </p>
            </div>
            <div class="download-actions">
              <a
                class="download-button"
                href={item.downloadUrl}
                aria-label={`Download ${item.name} r${item.revision} ZIP${platform ? ` for ${gameName}` : ""}`}
              >
                <span>Download ZIP{kind === "map" ? "" : " ·"}</span>
                <span class="download-size">
                  {(item.downloadBytes / 1_000_000).toLocaleString("en", {
                    maximumFractionDigits: 1,
                  })}{" "}
                  MB
                </span>
              </a>
              {(item.sourceUrl || kind === "map") && (
                <div class="secondary-links">
                  {item.sourceUrl && (
                    <a
                      href={item.sourceUrl}
                      aria-label={`Original ${kind} page for ${item.name}`}
                    >
                      Original {kind}
                    </a>
                  )}
                  {kind === "map" && (
                    <MapIssueLink
                      game={gameName}
                      name={item.name}
                      revision={item.revision}
                    />
                  )}
                </div>
              )}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </catalog-download-list>
)}

<script>
  class CatalogDownloadList extends HTMLElement {
    connectedCallback() {
      const filter = this.querySelector<HTMLDivElement>(".filter");
      const input = filter?.querySelector("input");
      const status = filter?.querySelector("[role=status]");
      if (!filter || !input || !status) return;
      const rows = this.querySelectorAll<HTMLElement>("li[data-search]");
      filter.hidden = false;
      input.oninput = () => {
        let count = 0;
        const query = input.value.trim().toLowerCase();
        for (const row of rows) {
          row.hidden = !row.dataset.search?.includes(query);
          if (!row.hidden) count++;
        }
        status.textContent =
          count === 0
            ? "No matching maps"
            : count === 1
              ? "1 map"
              : `${count} maps`;
      };
    }
  }
  if (!customElements.get("catalog-download-list"))
    customElements.define("catalog-download-list", CatalogDownloadList);
</script>

<style>
  catalog-download-list {
    display: block;
  }
  .catalog-status {
    padding: 0.9rem 1rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.4rem;
    background: var(--sl-color-bg-sidebar);
    color: var(--sl-color-gray-2);
  }
  .filter:not([hidden]) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }
  .filter input {
    flex: 1;
    font: inherit;
    min-width: 0;
    max-width: 21rem;
    padding: 0.45rem 0.75rem;
    color: var(--sl-color-white);
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.3rem;
  }
  .filter span {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }
  .catalog-downloads {
    padding: 0;
    list-style: none;
  }
  .catalog-downloads > li {
    padding: 1rem 0;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }
  .map-downloads {
    margin-block: 0.5rem 0;
  }
  .map-downloads > li {
    padding-block: 0.85rem;
  }
  .download-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    align-items: center;
  }
  .map-downloads .download-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 12.5rem;
  }
  .metadata {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    margin: 0.2rem 0 0;
  }
  .download-actions {
    display: grid;
    gap: 0.35rem;
  }
  .download-button {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.35rem;
    color: var(--sl-color-white);
    font-size: 0.875rem;
    font-weight: 650;
    text-decoration: none;
  }
  .map-downloads .download-button {
    justify-content: space-between;
    gap: 0.75rem;
  }
  .map-downloads .download-size {
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-xs);
    font-variant-numeric: tabular-nums;
  }
  .download-button:hover {
    background: var(--sl-color-accent-low);
    border-color: var(--sl-color-accent);
  }
  .secondary-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    justify-content: flex-end;
    font-size: var(--sl-text-xs);
  }
  .secondary-links :global(a) {
    color: var(--sl-color-gray-2);
    text-decoration-color: var(--sl-color-gray-4);
    text-underline-offset: 0.18em;
  }
  .secondary-links :global(a:hover) {
    color: var(--sl-color-accent-high);
    text-decoration-color: currentColor;
  }

  @media (max-width: 36rem) {
    .map-downloads .download-row {
      grid-template-columns: minmax(0, 1fr);
      justify-items: start;
    }
    .map-downloads .download-actions {
      width: min(100%, 12.5rem);
    }
    .secondary-links {
      justify-content: flex-start;
    }
  }
</style>
