---
import { Font, Image } from "astro:assets";
import "../styles/global.css";
import customModels from "../assets/custom_models.jpeg";
import mpUltimatePort from "../assets/mp_ultimate_port.jpeg";
import mpBouncerPort from "../assets/mp_bouncer_training_port.jpeg";
import mpMoRadiant from "../assets/mp_mo_test_iw3xo_radiant.png";
import mpMoIngame from "../assets/mp_mo_test_ingame.jpeg";
import mpCjmg2Radiant from "../assets/mp_cjmg2_iw3xo_radiant.png";
import mpCjmg2Ingame from "../assets/mp_cjmg2_ingame.jpeg";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />

    <!-- favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>CoD Xenon</title>
    <meta
      name="description"
      content="Open-source, community-driven modding for Call of Duty on the Xbox 360."
    />
    <Font cssVariable="--font-barlow-condensed" />
    <Font cssVariable="--font-barlow" />
    <Font cssVariable="--font-share-tech-mono" />
  </head>
  <body
    class="relative flex min-h-screen flex-col items-center bg-[#080909] text-white"
  >
    <!-- Grid background -->
    <div class="grid-bg absolute inset-0 opacity-[0.035]"></div>

    <!-- Green radial glow -->
    <div
      class="absolute inset-0"
      style="background: radial-gradient(ellipse 70% 55% at 50% 50%, rgba(34,197,94,0.07) 0%, transparent 65%);"
    >
    </div>

    <!-- Scanline overlay -->
    <div class="scanlines pointer-events-none fixed inset-0 z-20"></div>

    <main
      class="relative z-10 mx-auto flex w-full max-w-3xl flex-col items-center px-6 py-20 text-center"
    >
      <!-- Status pill -->
      <div
        class="mb-12 inline-flex items-center gap-2.5 border border-green-500/25 bg-green-500/5 px-5 py-2"
      >
        <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-green-400"
        ></span>
        <span
          class="font-mono text-xs tracking-[0.25em] text-green-400 uppercase"
          >Currently Building</span
        >
      </div>

      <!-- Wordmark -->
      <h1 class="font-condensed mb-6 leading-none font-black uppercase">
        <span
          class="block text-[clamp(5rem,18vw,12rem)] leading-none tracking-normal text-white"
          >CoD</span
        >
        <span
          class="block text-[clamp(5rem,18vw,12rem)] leading-none text-green-400"
          style="text-shadow: 0 0 60px rgba(34,197,94,0.35), 0 0 20px rgba(34,197,94,0.2);"
          >Xenon</span
        >
      </h1>

      <p
        class="mb-6 max-w-lg font-sans text-base leading-relaxed text-zinc-400"
      >
        Community-driven modding for Call of Duty on the Xbox 360 — pushing the
        platform further than ever before. The possibilities are endless.
      </p>

      <ul class="mb-14 w-full max-w-sm space-y-2 text-left">
        {
          [
            "Build fully custom maps from scratch using Radiant",
            "Port existing PC custom maps to Xbox 360",
            "Import and use custom models in-game",
            "And much more to come...",
          ].map((item) => (
            <li class="flex items-center gap-3 font-mono text-sm text-zinc-400">
              <span class="text-green-500">›</span>
              {item}
            </li>
          ))
        }
      </ul>

      <!-- CTA buttons -->
      <div class="mb-20 flex flex-col items-center gap-4 sm:flex-row">
        <a
          href="https://discord.com/invite/wCgjAMEQU5"
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center gap-3 bg-[#5865F2] px-8 py-4 text-white transition-colors duration-200 hover:bg-[#4752C4] sm:w-auto"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.03.056a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028 14.09 14.09 0 0 0 1.226-1.994.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.955-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"
            ></path>
          </svg>
          <span
            class="font-condensed text-base font-bold tracking-wider uppercase"
            >Join Discord</span
          >
        </a>
        <a
          href="https://github.com/codxenon"
          target="_blank"
          rel="noopener noreferrer"
          class="flex w-full items-center justify-center gap-3 border border-zinc-700 px-8 py-4 text-white transition-all duration-200 hover:border-green-500/50 hover:bg-green-500/5 sm:w-auto"
        >
          <svg
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"
            ></path>
          </svg>
          <span
            class="font-condensed text-base font-bold tracking-wider uppercase"
            >GitHub</span
          >
        </a>
      </div>

      <!-- Preview section -->
      <div class="w-full space-y-10">
        <!-- Divider -->
        <div class="flex items-center gap-4">
          <div class="h-px flex-1 bg-zinc-800"></div>
          <span
            class="font-mono text-xs tracking-[0.25em] text-zinc-600 uppercase"
            >Preview</span
          >
          <div class="h-px flex-1 bg-zinc-800"></div>
        </div>

        <!-- Radiant → In-Game -->
        <div>
          <p
            class="mb-3 font-mono text-xs tracking-[0.2em] text-zinc-500 uppercase"
          >
            Radiant → In-Game
          </p>
          <div class="space-y-3">
            <div class="grid grid-cols-2 gap-3">
              <div class="aspect-video overflow-hidden border border-zinc-800">
                <Image
                  src={mpMoRadiant}
                  alt="mp_mo_test in Radiant"
                  class="h-full w-full object-cover"
                />
              </div>
              <div class="aspect-video overflow-hidden border border-zinc-800">
                <Image
                  src={mpMoIngame}
                  alt="mp_mo_test in-game"
                  class="h-full w-full object-cover"
                />
              </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
              <div class="aspect-video overflow-hidden border border-zinc-800">
                <Image
                  src={mpCjmg2Radiant}
                  alt="mp_cjmg2 in Radiant"
                  class="h-full w-full object-cover"
                />
              </div>
              <div class="aspect-video overflow-hidden border border-zinc-800">
                <Image
                  src={mpCjmg2Ingame}
                  alt="mp_cjmg2 in-game"
                  class="h-full w-full object-cover"
                />
              </div>
            </div>
          </div>
        </div>

        <!-- Ported Maps -->
        <div>
          <p
            class="mb-3 font-mono text-xs tracking-[0.2em] text-zinc-500 uppercase"
          >
            Ported Maps
          </p>
          <div class="grid grid-cols-2 gap-3">
            <div class="aspect-video overflow-hidden border border-zinc-800">
              <Image
                src={mpUltimatePort}
                alt="mp_ultimate ported to Xbox 360"
                class="h-full w-full object-cover"
              />
            </div>
            <div class="aspect-video overflow-hidden border border-zinc-800">
              <Image
                src={mpBouncerPort}
                alt="mp_bouncer_training ported to Xbox 360"
                class="h-full w-full object-cover"
              />
            </div>
          </div>
        </div>

        <!-- Custom Models -->
        <div>
          <p
            class="mb-3 font-mono text-xs tracking-[0.2em] text-zinc-500 uppercase"
          >
            Custom Models
          </p>
          <div
            class="aspect-video w-full overflow-hidden border border-zinc-800"
          >
            <Image
              src={customModels}
              alt="Custom models loaded in-game"
              class="h-full w-full object-cover"
            />
          </div>
        </div>
      </div>
    </main>

    <footer
      class="absolute right-0 bottom-0 left-0 border-t border-zinc-900 px-6 py-5 text-center"
    >
      <p
        class="mx-auto max-w-2xl font-sans text-xs leading-relaxed text-zinc-600"
      >
        This project does not condone cheating and is not affiliated with or
        endorsed by any game publisher. CoD Xenon is an independent open-source
        community project for experimentation and fun.
      </p>
    </footer>
  </body>
</html>
